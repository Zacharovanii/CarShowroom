// CarShowroom — та же схема, что в 01_tables.sql, в формате DBML.
// Для быстрой картинки связей: https://dbdiagram.io/d → Import → DBML.
// Внимание: DBML не умеет CHECK и частичные индексы — их здесь нет.
// Источник истины — миграции apps/api/db/migrations; полная картина видна в живой БД
// (см. docs/db/README.md, раздел «Как смотреть схему»).

Table users {
  id uuid [pk]
  name text [not null]
  email text [not null, unique]
  email_verified boolean [not null]
  image text
  phone text [not null]
  role text [not null, note: 'user | manager | admin']
  banned boolean [not null]
  ban_reason text
  ban_expires timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token text [not null, unique]
  expires_at timestamptz [not null]
  ip_address text
  user_agent text
  impersonated_by uuid [ref: > users.id, note: 'admin-плагин: кто вошёл под клиентом']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table accounts {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  provider_id text [not null]
  account_id text [not null]
  password text [note: 'хеш; только provider_id = credential']
  access_token text [note: 'OAuth; всегда null — соцвход выключен']
  refresh_token text
  id_token text
  access_token_expires_at timestamptz
  refresh_token_expires_at timestamptz
  scope text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (provider_id, account_id) [unique]
  }
}

Table verifications {
  id uuid [pk]
  identifier text [not null]
  value text [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table series {
  id bigint [pk]
  name text [not null, unique]
  position smallint [not null, unique]
}

Table body_types {
  id bigint [pk]
  name text [not null, unique]
  position smallint [not null, unique]
}

Table fuel_types {
  id bigint [pk]
  name text [not null, unique]
  position smallint [not null, unique]
}

Table cars {
  id bigint [pk]
  series_id bigint [not null, ref: > series.id]
  body_type_id bigint [not null, ref: > body_types.id]
  fuel_type_id bigint [not null, ref: > fuel_types.id]
  slug text [not null, unique, note: 'адрес страницы: /catalog/x5-xdrive40i']
  name text [not null, unique]
  model_year smallint [not null]
  description text [not null]
  drive_type text [not null, note: 'rwd | xdrive']
  power_hp smallint [not null]
  acceleration_s "numeric(3,1)" [not null]
  top_speed_kmh smallint [not null]
  price "numeric(12,2)" [not null]
  model_3d_path text [note: 'GLB; null — только фото']
  paint_material text [note: 'имя материала краски в GLB']
  is_published boolean [not null]
  created_at timestamptz [not null]
}

Table car_images {
  id bigint [pk]
  car_id bigint [not null, ref: > cars.id]
  position smallint [not null, note: '1 = обложка']
  path text [not null, unique]
  alt text [not null]

  indexes {
    (car_id, position) [unique]
  }
}

Table colors {
  id bigint [pk]
  name text [not null, unique]
  hex text [not null]
}

Table car_colors {
  car_id bigint [not null, ref: > cars.id]
  color_id bigint [not null, ref: > colors.id]

  indexes {
    (car_id, color_id) [pk]
  }
}

Table test_drives {
  id bigint [pk]
  user_id uuid [not null, ref: > users.id, note: 'клиент, на кого запись']
  car_id bigint [not null, ref: > cars.id]
  starts_at timestamptz [not null]
  phone text [not null]
  comment text
  status text [not null, note: 'scheduled | completed | no_show | cancelled']
  closed_at timestamptz
  closed_by uuid [ref: > users.id, note: 'кто закрыл: клиент или сотрудник']
  cancel_reason text
  created_at timestamptz [not null]
}
