# Копия для локальной разработки — cp .env.example .env
# Значения совпадают с docker/compose.yml (сервис db).

# pg Pool модуля auth (Better Auth). postgres.js для остального кода
# читает эту же переменную отдельно, когда появится DatabaseModule (D7.1).
DATABASE_URL=postgres://carshowroom:carshowroom@localhost:5434/carshowroom?sslmode=disable

PORT=3000

# Секрет подписи cookie сессии. В dev — любое значение, перед деплоем —
# сгенерировать заново: npx @better-auth/cli@1.4.21 secret
BETTER_AUTH_SECRET=spike-s2-local-secret-change-me
BETTER_AUTH_URL=http://localhost:3000

# Origin фронта в dev: Vite отдаёт SPA со своего порта и проксирует /api сюда,
# поэтому браузер шлёт Origin именно этого порта. Без него Better Auth
# отвечает 403 INVALID_ORIGIN. В проде фронт и API на одном origin — не нужна.
WEB_ORIGIN=http://localhost:5173
