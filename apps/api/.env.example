# Копия для локальной разработки — cp .env.example .env
# Значения совпадают с docker/compose.yml (сервисы db и minio).

# Одна строка подключения на оба драйвера: pg Pool модуля auth (Better Auth)
# и postgres.js в DatabaseModule (D7.1).
DATABASE_URL=postgres://carshowroom:carshowroom@localhost:5434/carshowroom?sslmode=disable

PORT=3000

# Секрет подписи cookie сессии. Для локальной разработки подходит любое
# значение; на сервере — свой случайный: openssl rand -base64 32 (docs/deploy.md).
BETTER_AUTH_SECRET=dev-only-secret-not-for-production
BETTER_AUTH_URL=http://localhost:3000

# Origin фронта в dev: Vite отдаёт SPA со своего порта и проксирует /api сюда,
# поэтому браузер шлёт Origin именно этого порта. Без него Better Auth
# отвечает 403 INVALID_ORIGIN. localhost и 127.0.0.1 — разные origin, поэтому оба.
# В проде фронт и API на одном origin — не нужна.
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# S3-хранилище файлов, загруженных админом (D26) — сервис minio в compose.
# Консоль MinIO: http://localhost:9001. Регион MinIO не проверяет, но SDK
# без него не работает — us-east-1 принимается всегда.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=carshowroom
S3_ACCESS_KEY=carshowroom
S3_SECRET_KEY=carshowroom123

# Почта (D27) — письма подтверждения email и восстановления пароля через Resend.
# Без ключа письма не уходят: ссылка из письма пишется в лог API (контекст Mail),
# по ней можно пройти сценарий руками. В production обе переменные обязательны.
# Тестовый отправитель onboarding@resend.dev доставляет только на адрес владельца
# аккаунта Resend; для реальных адресов нужен свой подтверждённый (под)домен.
# RESEND_API_KEY=re_...
# MAIL_FROM=CarShowroom <onboarding@resend.dev>
