{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    // tsup подставляет устаревший baseUrl; без этого TS 6 роняет сборку .d.ts
