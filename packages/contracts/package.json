{
  "name": "@carshowroom/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "module": "./dist/index.js"
}
