# Прод-вход: HTTPS (сертификат Let's Encrypt Caddy получает сам), статика SPA
# и прокси в Nest. Домен — SITE_DOMAIN из docker/.env.
#
# Лимит тела запроса не задан намеренно: Caddy по умолчанию его не ставит,
# а админ загружает модели до 60 МБ — ограничивает сам API.

{$SITE_DOMAIN} {
	encode zstd gzip

	# /api (без слеша — hello-эндпоинт), API и Better Auth, файлы из MinIO
	# и seed-ассеты с заглушками — всё это отдаёт Nest.
	@backend path /api /api/* /media/* /assets/*
	handle @backend {
		# X-Forwarded-For Caddy ставит сам: адрес клиента, а входящий заголовок
		# от недоверенного источника отбрасывает (trusted_proxies не задан —
		# и не задавать). Better Auth получает ровно один адрес, его rateLimit
		# работает по клиенту. Дополнительных header_up не нужно.
		reverse_proxy api:3000
	}

	# Чанки, картинки и шрифты Vite: хеш в имени, кешируются навсегда.
	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Всё остальное — маршруты SPA: index.html, всегда перепроверяется,
	# чтобы после выкатки браузер сразу взял новые имена чанков.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
