# Переменные прода для docker/compose.prod.yml.
# На сервере: cp docker/.env.prod.example docker/.env и заполнить.
# Именно docker/.env — compose читает .env из каталога compose-файла.

# Домен сайта: на него Caddy получает сертификат, от него же BETTER_AUTH_URL.
SITE_DOMAIN=cars.tda-char.site

# Пароль Postgres подставляется в DATABASE_URL как есть, поэтому только
# [A-Za-z0-9] — спецсимволы ломают URL. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=

# MinIO (они же S3_ACCESS_KEY/S3_SECRET_KEY для API).
# Пароль не короче 8 символов: openssl rand -hex 24
MINIO_ROOT_USER=carshowroom
MINIO_ROOT_PASSWORD=

# Секрет подписи cookie сессии: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Секрет Django-раздела «Авто с пробегом» (подпись сессий и CSRF):
# openssl rand -base64 48
DJANGO_SECRET_KEY=

# Почта (D27), в production обязательна. Домен отправителя должен быть
# подтверждён в Resend. Значение с пробелами и <> — в кавычках.
RESEND_API_KEY=
MAIL_FROM="CarShowroom <noreply@tda-char.site>"
